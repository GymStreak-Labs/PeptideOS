  },
  "peptideContentLl37Description": "LL-37 is a human cathelicidin antimicrobial peptide involved in innate immune signalling. It is discussed in research communities for host-defense and tissue-response pathways, but safety considerations are significant.",
  "@peptideContentLl37Description": {
    "description": "Educational reference description for LL-37."
  },
  "peptideContentLl37TypicalDose": "Research protocols vary",
  "@peptideContentLl37TypicalDose": {
