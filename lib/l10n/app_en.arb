  },
  "peptideContentDihexaDescription": "Dihexa is an orally active angiotensin IV-derived peptide analogue studied preclinically for hepatocyte growth factor/c-Met signalling and synaptogenic activity. Human safety and efficacy data are not established.",
  "@peptideContentDihexaDescription": {
    "description": "Educational reference description for Dihexa."
  },
  "peptideContentDihexaTypicalDose": "Research-only; protocols vary",
  "@peptideContentDihexaTypicalDose": {
