  },
  "peptideContentGhrp2Description": "GHRP-2 is a synthetic growth hormone-releasing peptide that acts as a ghrelin receptor agonist. It has been studied for GH secretion, appetite signalling, and endocrine testing.",
  "@peptideContentGhrp2Description": {
    "description": "Educational reference description for GHRP-2."
  },
  "peptideContentGhrp2TypicalDose": "100–300 mcg per injection",
  "@peptideContentGhrp2TypicalDose": {
    "description": "Reference amount text for GHRP-2; this is not a dosing recommendation."
  },
  "peptideContentGhrp2HalfLife": "~20–30 minutes",
  "@peptideContentGhrp2HalfLife": {
    "description": "Educational half-life reference for GHRP-2."
  },
  "peptideContentGhrp2Notes": "Often paired with a GHRH analogue such as CJC-1295 no-DAC or Sermorelin. It may affect appetite, cortisol, and prolactin more than Ipamorelin.",
  "@peptideContentGhrp2Notes": {
    "description": "Neutral educational notes for GHRP-2; preserve non-prescriptive framing."
  },
  "peptideContentGhrp6Description": "GHRP-6 is a synthetic hexapeptide and ghrelin receptor agonist studied for growth-hormone release and appetite signalling. It is one of the older peptides in the GHRP family.",
  "@peptideContentGhrp6Description": {
    "description": "Educational reference description for GHRP-6."
  },
  "peptideContentGhrp6TypicalDose": "100–300 mcg per injection",
  "@peptideContentGhrp6TypicalDose": {
    "description": "Reference amount text for GHRP-6; this is not a dosing recommendation."
  },
  "peptideContentGhrp6HalfLife": "~20–30 minutes",
  "@peptideContentGhrp6HalfLife": {
    "description": "Educational half-life reference for GHRP-6."
  },
  "peptideContentGhrp6Notes": "Community use often emphasises appetite stimulation. More selective options such as Ipamorelin are commonly preferred when appetite effects are unwanted.",
  "@peptideContentGhrp6Notes": {
    "description": "Neutral educational notes for GHRP-6; preserve non-prescriptive framing."
  },
  "peptideContentHexarelinDescription": "Hexarelin is a synthetic growth hormone secretagogue and ghrelin receptor agonist studied for GH release and cardiovascular research signals. It is generally considered one of the more potent GHRPs.",
  "@peptideContentHexarelinDescription": {
    "description": "Educational reference description for Hexarelin."
  },
  "peptideContentHexarelinTypicalDose": "100–200 mcg per injection",
  "@peptideContentHexarelinTypicalDose": {
    "description": "Reference amount text for Hexarelin; this is not a dosing recommendation."
