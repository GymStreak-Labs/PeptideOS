    "sourceDescription": "Educational half-life reference for Retatrutide."
  },
  "peptideContentRetatrutideNotes": "Toujours en phase expérimentale — non approuvé par la FDA au moment de la rédaction. Toute utilisation en dehors d'un essai clinique relève strictement de la recherche.",
  "@peptideContentRetatrutideNotes": {
    "description": "Neutral educational notes for Retatrutide; preserve non-prescriptive framing.",
    "sourceString": "Still investigational — not FDA approved at time of writing. Any use outside a clinical trial is strictly research-only.",
    "sourceDescription": "Neutral educational notes for Retatrutide; preserve non-prescriptive framing."
  },
  "peptideContentIpamorelinDescription": "Ipamorelin est un pentapeptide mimétique de la ghréline et un sécrétagogue sélectif de l’hormone de croissance. Il a été étudié pour sa capacité à stimuler une libération pulsatile de GH avec un effet minimal sur le cortisol ou la prolactine.",
  "@peptideContentIpamorelinDescription": {
    "description": "Educational reference description for Ipamorelin.",
    "sourceString": "Ipamorelin is a pentapeptide ghrelin-mimetic and selective growth-hormone secretagogue. It has been investigated for its ability to stimulate a pulsatile GH release with minimal effect on cortisol or prolactin.",
    "sourceDescription": "Educational reference description for Ipamorelin."
  },
  "peptideContentIpamorelinTypicalDose": "200–300 mcg par injection",
  "@peptideContentIpamorelinTypicalDose": {
    "description": "Reference amount text for Ipamorelin; this is not a dosing recommendation.",
    "sourceString": "200–300 mcg per injection",
    "sourceDescription": "Reference amount text for Ipamorelin; this is not a dosing recommendation."
  },
  "peptideContentIpamorelinHalfLife": "~2 heures",
  "@peptideContentIpamorelinHalfLife": {
