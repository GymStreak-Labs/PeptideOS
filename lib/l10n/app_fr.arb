  },
  "peptideContentBpc157Description": "Le BPC-157 (Body Protection Compound 157) est un peptide synthétique de 15 acides aminés dérivé d'une protéine présente dans le suc gastrique. Il a été étudié dans des modèles animaux pour son rôle dans la réparation des tissus mous et de la muqueuse intestinale. Les données cliniques chez l'humain restent limitées.",
  "@peptideContentBpc157Description": {
    "description": "Educational reference description for BPC-157.",
    "sourceString": "BPC-157 (Body Protection Compound 157) is a 15-amino-acid synthetic peptide derived from a protein found in gastric juice. It has been studied in animal models for its role in soft-tissue and gut-lining repair. Human clinical data remains limited.",
    "sourceDescription": "Educational reference description for BPC-157."
  },
  "peptideContentBpc157TypicalDose": "250 à 500 µg",
  "@peptideContentBpc157TypicalDose": {
    "description": "Reference amount text for BPC-157; this is not a dosing recommendation.",
    "sourceString": "250–500 mcg",
    "sourceDescription": "Reference amount text for BPC-157; this is not a dosing recommendation."
  },
  "peptideContentBpc157HalfLife": "~4 heures",
  "@peptideContentBpc157HalfLife": {
    "description": "Educational half-life reference for BPC-157.",
    "sourceString": "~4 hours",
    "sourceDescription": "Educational half-life reference for BPC-157."
  },
  "peptideContentBpc157Notes": "Reconstituer avec de l'eau bactériostatique et conserver au réfrigérateur. Souvent associé au TB-500 dans les protocoles de récupération des tendons et ligaments étudiés chez l'animal.",
  "@peptideContentBpc157Notes": {
    "description": "Neutral educational notes for BPC-157; preserve non-prescriptive framing.",
    "sourceString": "Reconstitute with bacteriostatic water and store refrigerated. Commonly stacked with TB-500 for tendon and ligament recovery protocols in animal studies.",
    "sourceDescription": "Neutral educational notes for BPC-157; preserve non-prescriptive framing."
  },
  "peptideContentTb500Description": "Le TB-500 est un fragment synthétique de la protéine naturelle thymosine bêta-4. Dans des études animales, il a été examiné pour son rôle dans la migration cellulaire et la régénération tissulaire. Il est largement utilisé hors indication par des chercheurs et en contexte vétérinaire.",
  "@peptideContentTb500Description": {
    "description": "Educational reference description for TB-500.",
    "sourceString": "TB-500 is a synthetic fragment of the naturally occurring protein thymosin beta-4. In animal studies it has been investigated for roles in cellular migration and tissue regeneration. It is widely used off-label by researchers and in veterinary settings.",
    "sourceDescription": "Educational reference description for TB-500."
  },
  "peptideContentTb500TypicalDose": "2–5 mg par semaine en phase de charge, puis 2 mg en entretien",
  "@peptideContentTb500TypicalDose": {
    "description": "Reference amount text for TB-500; this is not a dosing recommendation.",
    "sourceString": "2–5 mg weekly loading, then 2 mg maintenance",
    "sourceDescription": "Reference amount text for TB-500; this is not a dosing recommendation."
  },
  "peptideContentTb500HalfLife": "~2 jours",
  "@peptideContentTb500HalfLife": {
    "description": "Educational half-life reference for TB-500.",
    "sourceString": "~2 days",
    "sourceDescription": "Educational half-life reference for TB-500."
  },
  "peptideContentTb500Notes": "Souvent associé au BPC-157 dans les protocoles ciblant les tissus mous. Une répartition de la dose deux fois par semaine est courante en raison de la longue demi-vie.",
  "@peptideContentTb500Notes": {
    "description": "Neutral educational notes for TB-500; preserve non-prescriptive framing.",
    "sourceString": "Often paired with BPC-157 for soft-tissue protocols. Split dosing twice weekly is common due to long half-life.",
    "sourceDescription": "Neutral educational notes for TB-500; preserve non-prescriptive framing."
  },
  "peptideContentGhkCuDescription": "Le GHK-Cu (peptide de cuivre) est un tripeptide naturel liant le cuivre, présent dans le plasma humain. Il a été étudié dans des applications cosmétiques topiques pour le remodelage cutané et la signalisation des follicules pileux.",
  "@peptideContentGhkCuDescription": {
    "description": "Educational reference description for GHK-Cu.",
    "sourceString": "GHK-Cu (Copper Peptide) is a naturally occurring copper-binding tripeptide present in human plasma. It has been studied in topical cosmetic applications for skin remodelling and hair-follicle signalling.",
    "sourceDescription": "Educational reference description for GHK-Cu."
  },
  "peptideContentGhkCuTypicalDose": "1 à 2 mg",
  "@peptideContentGhkCuTypicalDose": {
    "description": "Reference amount text for GHK-Cu; this is not a dosing recommendation.",
    "sourceString": "1–2 mg",
    "sourceDescription": "Reference amount text for GHK-Cu; this is not a dosing recommendation."
  },
  "peptideContentGhkCuHalfLife": "~1 heure",
  "@peptideContentGhkCuHalfLife": {
