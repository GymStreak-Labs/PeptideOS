  "peptideContentHcgDescription": "A gonadotrofina coriônica humana (HCG) é um hormônio glicoproteico usado em contextos clínicos regulados e frequentemente mencionado ao lado de protocolos com peptídeos. Este item é fornecido como referência neutra de rastreamento para cronogramas inseridos pelo usuário.",
  "@peptideContentHcgDescription": {
    "sourceString": "Human chorionic gonadotropin (HCG) is a glycoprotein hormone used in regulated clinical settings and frequently discussed alongside peptide protocols. This entry is provided as a neutral tracking reference for user-entered schedules.",
    "sourceDescription": "Educational reference description for HCG."
  },
  "peptideContentHcgTypicalDose": "UI inserida pelo usuário",
  "@peptideContentHcgTypicalDose": {
    "sourceString": "User-entered IU",
    "sourceDescription": "Reference amount text for HCG; this is not a dosing recommendation."
  },
  "peptideContentHcgHalfLife": "~24-36 horas",
  "@peptideContentHcgHalfLife": {
    "sourceString": "~24-36 hours",
    "sourceDescription": "Educational half-life reference for HCG."
  },
  "peptideContentHcgNotes": "Uso sob prescrição em muitas jurisdições. Registre apenas o que já foi indicado por um profissional de saúde qualificado; o PepMod não fornece orientação de dosagem para HCG.",
  "@peptideContentHcgNotes": {
    "sourceString": "Prescription-only in many jurisdictions. Track only what has already been directed by a qualified healthcare professional; PepMod does not provide HCG dosing guidance.",
    "sourceDescription": "Neutral educational notes for HCG; preserve non-prescriptive framing."
  },
  "peptideContentBpc157Description": "BPC-157 (Body Protection Compound 157) é um peptídeo sintético de 15 aminoácidos derivado de uma proteína encontrada no suco gástrico. Foi estudado em modelos animais quanto ao seu papel na reparação de tecidos moles e do revestimento intestinal. Os dados clínicos em humanos ainda são limitados.",
  "@peptideContentBpc157Description": {
    "sourceString": "BPC-157 (Body Protection Compound 157) is a 15-amino-acid synthetic peptide derived from a protein found in gastric juice. It has been studied in animal models for its role in soft-tissue and gut-lining repair. Human clinical data remains limited.",
    "sourceDescription": "Educational reference description for BPC-157."
  },
  "peptideContentBpc157TypicalDose": "250–500 mcg",
  "@peptideContentBpc157TypicalDose": {
    "sourceString": "250–500 mcg",
    "sourceDescription": "Reference amount text for BPC-157; this is not a dosing recommendation."
  },
  "peptideContentBpc157HalfLife": "~4 horas",
  "@peptideContentBpc157HalfLife": {
    "sourceString": "~4 hours",
    "sourceDescription": "Educational half-life reference for BPC-157."
  },
  "peptideContentBpc157Notes": "Em estudos com animais, o BPC-157 é frequentemente mencionado junto com o TB-500 em protocolos de pesquisa sobre tendões e ligamentos. Esta referência não fornece instruções de reconstituição nem de uso.",
  "@peptideContentBpc157Notes": {
    "sourceString": "Reconstitute with bacteriostatic water and store refrigerated. Commonly stacked with TB-500 for tendon and ligament recovery protocols in animal studies.",
    "sourceDescription": "Neutral educational notes for BPC-157; preserve non-prescriptive framing."
  },
  "peptideContentTb500Description": "TB-500 é um fragmento sintético da proteína timosina beta-4, encontrada naturalmente no organismo. Em estudos com animais, foi investigado quanto ao seu papel na migração celular e na regeneração de tecidos. É amplamente usado off-label por pesquisadores e em contextos veterinários.",
  "@peptideContentTb500Description": {
    "sourceString": "TB-500 is a synthetic fragment of the naturally occurring protein thymosin beta-4. In animal studies it has been investigated for roles in cellular migration and tissue regeneration. It is widely used off-label by researchers and in veterinary settings.",
    "sourceDescription": "Educational reference description for TB-500."
  },
  "peptideContentTb500TypicalDose": "2–5 mg semanais de ataque, depois 2 mg de manutenção",
  "@peptideContentTb500TypicalDose": {
    "sourceString": "2–5 mg weekly loading, then 2 mg maintenance",
    "sourceDescription": "Reference amount text for TB-500; this is not a dosing recommendation."
  },
  "peptideContentTb500HalfLife": "~2 dias",
  "@peptideContentTb500HalfLife": {
    "sourceString": "~2 days",
    "sourceDescription": "Educational half-life reference for TB-500."
  },
  "peptideContentTb500Notes": "Frequentemente combinado com BPC-157 em protocolos para tecidos moles. Dose dividida duas vezes por semana é comum devido à meia-vida longa.",
  "@peptideContentTb500Notes": {
    "sourceString": "Often paired with BPC-157 for soft-tissue protocols. Split dosing twice weekly is common due to long half-life.",
    "sourceDescription": "Neutral educational notes for TB-500; preserve non-prescriptive framing."
  },
  "peptideContentGhkCuDescription": "GHK-Cu (peptídeo de cobre) é um tripeptídeo ligante de cobre que ocorre naturalmente no plasma humano. Foi estudado em aplicações cosméticas tópicas relacionadas à remodelação da pele e à sinalização dos folículos capilares.",
  "@peptideContentGhkCuDescription": {
    "sourceString": "GHK-Cu (Copper Peptide) is a naturally occurring copper-binding tripeptide present in human plasma. It has been studied in topical cosmetic applications for skin remodelling and hair-follicle signalling.",
    "sourceDescription": "Educational reference description for GHK-Cu."
  },
  "peptideContentGhkCuTypicalDose": "1–2 mg",
  "@peptideContentGhkCuTypicalDose": {
    "sourceString": "1–2 mg",
    "sourceDescription": "Reference amount text for GHK-Cu; this is not a dosing recommendation."
  },
  "peptideContentGhkCuHalfLife": "~1 hora",
  "@peptideContentGhkCuHalfLife": {
    "sourceString": "~1 hour",
    "sourceDescription": "Educational half-life reference for GHK-Cu."
  },
  "peptideContentGhkCuNotes": "Também usado topicamente em formulações para a pele. A dose subcutânea costuma ser menor do que as concentrações tópicas.",
  "@peptideContentGhkCuNotes": {
    "sourceString": "Also used topically in skincare formulations. Subcutaneous dosing is typically lower than topical concentrations.",
    "sourceDescription": "Neutral educational notes for GHK-Cu; preserve non-prescriptive framing."
  },
  "peptideContentEpitalonDescription": "Epitalon é um tetrapeptídeo sintético análogo à epitalamina, um peptídeo extraído da glândula pineal. Pesquisas russas exploraram seus efeitos sobre a atividade da telomerase e a regulação circadiana.",
  "@peptideContentEpitalonDescription": {
    "sourceString": "Epitalon is a synthetic tetrapeptide analogue of epithalamin, a peptide extracted from the pineal gland. Russian research has explored its effects on telomerase activity and circadian regulation.",
    "sourceDescription": "Educational reference description for Epitalon."
  },
  "peptideContentEpitalonTypicalDose": "5–10 mg por dia de ciclo",
  "@peptideContentEpitalonTypicalDose": {
    "sourceString": "5–10 mg per cycle day",
    "sourceDescription": "Reference amount text for Epitalon; this is not a dosing recommendation."
  },
  "peptideContentEpitalonHalfLife": "~30 minutos",
  "@peptideContentEpitalonHalfLife": {
    "sourceString": "~30 minutes",
    "sourceDescription": "Educational half-life reference for Epitalon."
  },
  "peptideContentEpitalonNotes": "Costuma ser usado em ciclos curtos e pulsados (por exemplo, 10–20 dias de uso, meses de pausa), com base em protocolos russos de pesquisa sobre longevidade.",
  "@peptideContentEpitalonNotes": {
    "sourceString": "Typically run in short pulsed cycles (e.g., 10–20 days on, months off) based on Russian longevity research protocols.",
    "sourceDescription": "Neutral educational notes for Epitalon; preserve non-prescriptive framing."
  },
  "peptideContentSemaglutideDescription": "A semaglutida é um agonista do receptor de GLP-1 originalmente desenvolvido para o diabetes tipo 2 e posteriormente aprovado para o controle crônico do peso sob as marcas Ozempic e Wegovy. Ela retarda o esvaziamento gástrico e modula a sinalização de apetite.",
  "@peptideContentSemaglutideDescription": {
    "sourceString": "Semaglutide is a GLP-1 receptor agonist originally developed for type 2 diabetes and later approved for chronic weight management under brand names Ozempic and Wegovy. It slows gastric emptying and modulates appetite signalling.",
    "sourceDescription": "Educational reference description for Semaglutide."
  },
  "peptideContentSemaglutideTypicalDose": "0.25–2.4 mg semanais (com ajuste gradual)",
  "@peptideContentSemaglutideTypicalDose": {
    "sourceString": "0.25–2.4 mg weekly (titrated)",
    "sourceDescription": "Reference amount text for Semaglutide; this is not a dosing recommendation."
  },
  "peptideContentSemaglutideHalfLife": "~7 dias",
  "@peptideContentSemaglutideHalfLife": {
    "sourceString": "~7 days",
    "sourceDescription": "Educational half-life reference for Semaglutide."
  },
  "peptideContentSemaglutideNotes": "Uso sob prescrição na maioria dos países. O esquema de titulação começa baixo e aumenta a cada 4 semanas para controlar efeitos colaterais gastrointestinais.",
  "@peptideContentSemaglutideNotes": {
    "sourceString": "Prescription only in most countries. Titration schedule starts low and increases every 4 weeks to manage GI side effects.",
    "sourceDescription": "Neutral educational notes for Semaglutide; preserve non-prescriptive framing."
  },
  "peptideContentTirzepatideDescription": "A tirzepatida é um agonista duplo dos receptores GIP/GLP-1 aprovado para o diabetes tipo 2 (Mounjaro) e para a obesidade (Zepbound). Ensaios clínicos demonstraram que ela produz reduções de peso maiores do que os agonistas de GLP-1 isolados.",
  "@peptideContentTirzepatideDescription": {
    "sourceString": "Tirzepatide is a dual GIP/GLP-1 receptor agonist approved for type 2 diabetes (Mounjaro) and obesity (Zepbound). Clinical trials have shown it to produce larger weight reductions than single-agonist GLP-1s.",
    "sourceDescription": "Educational reference description for Tirzepatide."
  },
  "peptideContentTirzepatideTypicalDose": "2.5–15 mg semanais (com ajuste gradual)",
  "@peptideContentTirzepatideTypicalDose": {
    "sourceString": "2.5–15 mg weekly (titrated)",
    "sourceDescription": "Reference amount text for Tirzepatide; this is not a dosing recommendation."
  },
  "peptideContentTirzepatideHalfLife": "~5 dias",
  "@peptideContentTirzepatideHalfLife": {
    "sourceString": "~5 days",
    "sourceDescription": "Educational half-life reference for Tirzepatide."
  },
  "peptideContentTirzepatideNotes": "Uso sob prescrição na maioria dos países. A titulação padrão ocorre em incrementos de 4 semanas. Aplicado por via subcutânea uma vez por semana.",
  "@peptideContentTirzepatideNotes": {
    "sourceString": "Prescription only in most countries. Standard titration is 4-week increments. Injected subcutaneously once weekly.",
    "sourceDescription": "Neutral educational notes for Tirzepatide; preserve non-prescriptive framing."
  },
  "peptideContentRetatrutideDescription": "A retatrutida é um agonista triplo em fase de investigação, direcionado aos receptores GIP, GLP-1 e glucagon. Ensaios de fase 2 relataram reduções de peso superiores às das terapias existentes baseadas em GLP-1.",
  "@peptideContentRetatrutideDescription": {
    "sourceString": "Retatrutide is an investigational triple agonist targeting GIP, GLP-1, and glucagon receptors. Phase 2 trials reported weight reductions exceeding those of existing GLP-1-based therapies.",
    "sourceDescription": "Educational reference description for Retatrutide."
  },
  "peptideContentRetatrutideTypicalDose": "Doses de estudo de 1–12 mg semanais",
  "@peptideContentRetatrutideTypicalDose": {
    "sourceString": "Trial doses 1–12 mg weekly",
    "sourceDescription": "Reference amount text for Retatrutide; this is not a dosing recommendation."
  },
  "peptideContentRetatrutideHalfLife": "~6 dias",
  "@peptideContentRetatrutideHalfLife": {
    "sourceString": "~6 days",
    "sourceDescription": "Educational half-life reference for Retatrutide."
  },
  "peptideContentRetatrutideNotes": "Ainda em fase de investigação — sem aprovação da FDA até o momento desta publicação. Qualquer uso fora de um ensaio clínico é estritamente para fins de pesquisa.",
  "@peptideContentRetatrutideNotes": {
    "sourceString": "Still investigational — not FDA approved at time of writing. Any use outside a clinical trial is strictly research-only.",
    "sourceDescription": "Neutral educational notes for Retatrutide; preserve non-prescriptive framing."
  },
  "peptideContentIpamorelinDescription": "A ipamorelina é um pentapeptídeo mimético da grelina e secretagogo seletivo do hormônio do crescimento. Foi investigada quanto à sua capacidade de estimular uma liberação pulsátil de GH com efeito mínimo sobre o cortisol ou a prolactina.",
  "@peptideContentIpamorelinDescription": {
    "sourceString": "Ipamorelin is a pentapeptide ghrelin-mimetic and selective growth-hormone secretagogue. It has been investigated for its ability to stimulate a pulsatile GH release with minimal effect on cortisol or prolactin.",
    "sourceDescription": "Educational reference description for Ipamorelin."
  },
  "peptideContentIpamorelinTypicalDose": "200–300 mcg por injeção",
  "@peptideContentIpamorelinTypicalDose": {
    "sourceString": "200–300 mcg per injection",
    "sourceDescription": "Reference amount text for Ipamorelin; this is not a dosing recommendation."
  },
  "peptideContentIpamorelinHalfLife": "~2 horas",
  "@peptideContentIpamorelinHalfLife": {
    "sourceString": "~2 hours",
    "sourceDescription": "Educational half-life reference for Ipamorelin."
  },
  "peptideContentIpamorelinNotes": "Frequentemente combinado com CJC-1295 (sem DAC) para um pulso sinérgico de GH. Horário típico: antes de dormir e/ou antes do treino, em jejum.",
  "@peptideContentIpamorelinNotes": {
    "sourceString": "Commonly stacked with CJC-1295 (no DAC) for a synergistic GH pulse. Typical timing: before bed and/or pre-workout on an empty stomach.",
    "sourceDescription": "Neutral educational notes for Ipamorelin; preserve non-prescriptive framing."
  },
  "peptideContentCjc1295DacDescription": "CJC-1295 é um análogo sintético do GHRH. A variante DAC (Drug Affinity Complex) se liga à albumina sérica, prolongando sua meia-vida e produzindo níveis sustentados de GH em vez de picos isolados.",
  "@peptideContentCjc1295DacDescription": {
    "sourceString": "CJC-1295 is a synthetic GHRH analogue. The DAC (Drug Affinity Complex) variant binds to serum albumin, extending its half-life and producing sustained GH levels rather than discrete pulses.",
    "sourceDescription": "Educational reference description for CJC-1295 (with DAC)."
  },
  "peptideContentCjc1295DacTypicalDose": "1–2 mg semanais",
  "@peptideContentCjc1295DacTypicalDose": {
    "sourceString": "1–2 mg weekly",
    "sourceDescription": "Reference amount text for CJC-1295 (with DAC); this is not a dosing recommendation."
  },
  "peptideContentCjc1295DacHalfLife": "~8 dias",
  "@peptideContentCjc1295DacHalfLife": {
    "sourceString": "~8 days",
    "sourceDescription": "Educational half-life reference for CJC-1295 (with DAC)."
  },
  "peptideContentCjc1295DacNotes": "Ação prolongada — geralmente aplicado uma ou duas vezes por semana. Eleva o nível basal de GH/IGF-1 em vez de gerar pulsos acentuados.",
  "@peptideContentCjc1295DacNotes": {
    "sourceString": "Long-acting — typically dosed once or twice per week. Elevates baseline GH/IGF-1 rather than producing sharp pulses.",
    "sourceDescription": "Neutral educational notes for CJC-1295 (with DAC); preserve non-prescriptive framing."
  },
  "peptideContentCjc1295NoDacDescription": "CJC-1295 sem DAC — também conhecido como Mod-GRF(1-29) — é um análogo do GHRH com meia-vida curta. Geralmente é combinado com um GHRP, como a ipamorelina, para desencadear a liberação pulsátil natural de GH.",
  "@peptideContentCjc1295NoDacDescription": {
    "sourceString": "CJC-1295 without DAC — also known as Mod-GRF(1-29) — is a GHRH analogue with a short half-life. It is typically combined with a GHRP such as Ipamorelin to trigger natural pulsatile GH release.",
    "sourceDescription": "Educational reference description for CJC-1295 (no DAC)."
  },
  "peptideContentCjc1295NoDacTypicalDose": "100 mcg por injeção",
  "@peptideContentCjc1295NoDacTypicalDose": {
    "sourceString": "100 mcg per injection",
    "sourceDescription": "Reference amount text for CJC-1295 (no DAC); this is not a dosing recommendation."
  },
  "peptideContentCjc1295NoDacHalfLife": "~30 minutos",
  "@peptideContentCjc1295NoDacHalfLife": {
    "sourceString": "~30 minutes",
    "sourceDescription": "Educational half-life reference for CJC-1295 (no DAC)."
  },
  "peptideContentCjc1295NoDacNotes": "Ação curta — combinado com um GHRP (Ipamorelin, GHRP-2, GHRP-6) para amplificar os pulsos de GH. Normalmente aplicado de 1 a 3 vezes por dia, em jejum.",
  "@peptideContentCjc1295NoDacNotes": {
    "sourceString": "Short acting — stack with a GHRP (Ipamorelin, GHRP-2, GHRP-6) to amplify GH pulses. Usually dosed 1–3x per day on an empty stomach.",
    "sourceDescription": "Neutral educational notes for CJC-1295 (no DAC); preserve non-prescriptive framing."
  },
  "peptideContentTesamorelinDescription": "A tesamorelina é um análogo estabilizado do GHRH aprovado para reduzir o excesso de gordura visceral abdominal na lipodistrofia associada ao HIV (nome comercial Egrifta). Também foi estudada em contextos de envelhecimento cognitivo.",
  "@peptideContentTesamorelinDescription": {
    "sourceString": "Tesamorelin is a stabilised GHRH analogue approved to reduce excess abdominal visceral fat in HIV-associated lipodystrophy (brand name Egrifta). It has also been studied in cognitive ageing contexts.",
    "sourceDescription": "Educational reference description for Tesamorelin."
  },
  "peptideContentTesamorelinTypicalDose": "1–2 mg por dia",
  "@peptideContentTesamorelinTypicalDose": {
    "sourceString": "1–2 mg daily",
    "sourceDescription": "Reference amount text for Tesamorelin; this is not a dosing recommendation."
  },
  "peptideContentTesamorelinHalfLife": "~30 minutos",
  "@peptideContentTesamorelinHalfLife": {
    "sourceString": "~30 minutes",
    "sourceDescription": "Educational half-life reference for Tesamorelin."
  },
  "peptideContentTesamorelinNotes": "Medicamento sob prescrição. Estudado principalmente para redução do tecido adiposo visceral. Administrado uma vez ao dia por via subcutânea.",
  "@peptideContentTesamorelinNotes": {
    "sourceString": "Prescription medication. Primarily studied for visceral adipose tissue reduction. Administered once daily subcutaneously.",
    "sourceDescription": "Neutral educational notes for Tesamorelin; preserve non-prescriptive framing."
  },
  "peptideContentMotsCDescription": "MOTS-c é um peptídeo de origem mitocondrial codificado dentro do gene MT-RNR1. Pesquisas investigaram seu papel na homeostase metabólica, na sensibilidade à insulina e na fisiologia do exercício.",
  "@peptideContentMotsCDescription": {
    "sourceString": "MOTS-c is a mitochondrial-derived peptide encoded within the MT-RNR1 gene. Research has investigated its role in metabolic homeostasis, insulin sensitivity, and exercise physiology.",
    "sourceDescription": "Educational reference description for MOTS-c."
  },
  "peptideContentMotsCTypicalDose": "5–10 mg 2–3x por semana",
  "@peptideContentMotsCTypicalDose": {
    "sourceString": "5–10 mg 2–3x per week",
    "sourceDescription": "Reference amount text for MOTS-c; this is not a dosing recommendation."
  },
  "peptideContentMotsCHalfLife": "~90 minutos",
  "@peptideContentMotsCHalfLife": {
    "sourceString": "~90 minutes",
    "sourceDescription": "Educational half-life reference for MOTS-c."
  },
  "peptideContentMotsCNotes": "Pesquisa ainda emergente. Alguns usuários relatam melhora na recuperação do exercício e em marcadores metabólicos em registros de autoexperimentação.",
  "@peptideContentMotsCNotes": {
    "sourceString": "Research still emerging. Some users report improved exercise recovery and metabolic markers in self-experiment logs.",
    "sourceDescription": "Neutral educational notes for MOTS-c; preserve non-prescriptive framing."
  },
  "peptideContentCerebrolysinDescription": "Cerebrolysin é uma mistura de peptídeos de baixo peso molecular e aminoácidos derivados de tecido cerebral suíno. É prescrito em vários países da Europa e da Ásia para indicações neurodegenerativas e de recuperação pós-AVC.",
  "@peptideContentCerebrolysinDescription": {
    "sourceString": "Cerebrolysin is a mixture of low-molecular-weight peptides and amino acids derived from porcine brain tissue. It is prescribed in several European and Asian countries for neurodegenerative and stroke-recovery indications.",
    "sourceDescription": "Educational reference description for Cerebrolysin."
  },
  "peptideContentCerebrolysinTypicalDose": "Ampolas de 5–30 ml (ambiente clínico)",
  "@peptideContentCerebrolysinTypicalDose": {
    "sourceString": "5–30 ml ampoules (clinical setting)",
    "sourceDescription": "Reference amount text for Cerebrolysin; this is not a dosing recommendation."
  },
  "peptideContentCerebrolysinHalfLife": "Variável (mistura)",
  "@peptideContentCerebrolysinHalfLife": {
    "sourceString": "Variable (mixture)",
    "sourceDescription": "Educational half-life reference for Cerebrolysin."
  },
  "peptideContentCerebrolysinNotes": "Geralmente administrado em ciclos sob supervisão clínica. Não disponível nos EUA. Pesquisado em AVC isquêmico e na doença de Alzheimer.",
  "@peptideContentCerebrolysinNotes": {
    "sourceString": "Typically administered as a course under clinical supervision. Not available in the US. Research in ischemic stroke and Alzheimer's disease.",
    "sourceDescription": "Neutral educational notes for Cerebrolysin; preserve non-prescriptive framing."
  },
  "peptideContentSelankDescription": "Selank é um heptapeptídeo sintético desenvolvido na Rússia como análogo do peptídeo imunomodulador tuftsina. Foi estudado quanto a efeitos ansiolíticos sem a sedação ou a dependência associadas aos benzodiazepínicos.",
  "@peptideContentSelankDescription": {
    "sourceString": "Selank is a synthetic heptapeptide developed in Russia as an analogue of the immunomodulatory peptide tuftsin. It has been studied for anxiolytic effects without the sedation or dependence of benzodiazepines.",
    "sourceDescription": "Educational reference description for Selank."
  },
  "peptideContentSelankTypicalDose": "250–500 mcg via intranasal",
  "@peptideContentSelankTypicalDose": {
    "sourceString": "250–500 mcg intranasally",
    "sourceDescription": "Reference amount text for Selank; this is not a dosing recommendation."
  },
  "peptideContentSelankHalfLife": "~poucos minutos (sistêmico)",
  "@peptideContentSelankHalfLife": {
    "sourceString": "~few minutes (systemic)",
    "sourceDescription": "Educational half-life reference for Selank."
  },
  "peptideContentSelankNotes": "Administrado com mais frequência por via intranasal. A pesquisa russa concentra-se em ansiedade e atenção. Meia-vida curta, mas os efeitos relatados duram várias horas.",
  "@peptideContentSelankNotes": {
    "sourceString": "Most commonly administered intranasally. Russian research focuses on anxiety and attention. Short half-life but reported effects last several hours.",
    "sourceDescription": "Neutral educational notes for Selank; preserve non-prescriptive framing."
  },
  "peptideContentSemaxDescription": "Semax é um heptapeptídeo sintético derivado de um fragmento do ACTH (4–10). Pesquisas russas investigaram seus efeitos nootrópicos e neuroprotetores, particularmente em protocolos de recuperação pós-AVC.",
  "@peptideContentSemaxDescription": {
    "sourceString": "Semax is a synthetic heptapeptide derived from a fragment of ACTH (4–10). Russian research has investigated its nootropic and neuroprotective effects, particularly in stroke recovery protocols.",
    "sourceDescription": "Educational reference description for Semax."
  },
  "peptideContentSemaxTypicalDose": "250–1000 mcg via intranasal",
  "@peptideContentSemaxTypicalDose": {
    "sourceString": "250–1000 mcg intranasally",
    "sourceDescription": "Reference amount text for Semax; this is not a dosing recommendation."
  },
  "peptideContentSemaxHalfLife": "~30 minutos",
  "@peptideContentSemaxHalfLife": {
    "sourceString": "~30 minutes",
    "sourceDescription": "Educational half-life reference for Semax."
  },
  "peptideContentSemaxNotes": "A administração intranasal é a mais comum. Aprovado na Rússia para AVC isquêmico. Frequentemente alternado em ciclos com Selank para efeitos complementares.",
  "@peptideContentSemaxNotes": {
    "sourceString": "Intranasal administration is typical. Approved in Russia for ischaemic stroke. Often cycled with Selank for complementary effects.",
    "sourceDescription": "Neutral educational notes for Semax; preserve non-prescriptive framing."
  },
  "peptideContentMelanotanIiDescription": "A melanotan II é um análogo sintético do hormônio estimulante de alfa-melanócitos (α-MSH). Foi originalmente desenvolvida como possível agente de bronzeamento sem exposição solar e também tem sido associada a efeitos sobre apetite e libido.",
  "@peptideContentMelanotanIiDescription": {
    "sourceString": "Melanotan II is a synthetic analogue of the alpha-melanocyte-stimulating hormone (α-MSH). It was originally developed as a potential sunless tanning agent and has also been associated with appetite and libido effects.",
    "sourceDescription": "Educational reference description for Melanotan II."
  },
  "peptideContentMelanotanIiTypicalDose": "250–1000 mcg de ataque, depois manutenção",
  "@peptideContentMelanotanIiTypicalDose": {
    "sourceString": "250–1000 mcg loading, then maintenance",
    "sourceDescription": "Reference amount text for Melanotan II; this is not a dosing recommendation."
  },
  "peptideContentMelanotanIiHalfLife": "~1 hora",
  "@peptideContentMelanotanIiHalfLife": {
    "sourceString": "~1 hour",
    "sourceDescription": "Educational half-life reference for Melanotan II."
  },
  "peptideContentMelanotanIiNotes": "Não aprovado para nenhum uso médico. Efeitos colaterais comumente relatados incluem náusea e escurecimento de pintas já existentes. Qualquer pinta nova ou que mude deve ser avaliada por um dermatologista.",
  "@peptideContentMelanotanIiNotes": {
    "sourceString": "Not approved for any medical use. Common reported side effects include nausea and darkening of existing moles. Any new or changing mole should be evaluated by a dermatologist.",
    "sourceDescription": "Neutral educational notes for Melanotan II; preserve non-prescriptive framing."
  },
  "peptideContentPt141Description": "PT-141, também conhecido como bremelanotida e comercializado como Vyleesi, é um agonista dos receptores de melanocortina aprovado pela FDA para o transtorno do desejo sexual hipoativo em mulheres na pré-menopausa. Atua sobre vias do sistema nervoso central.",
  "@peptideContentPt141Description": {
    "sourceString": "PT-141, also known as Bremelanotide and marketed as Vyleesi, is a melanocortin receptor agonist approved by the FDA for hypoactive sexual desire disorder in premenopausal women. It acts on central nervous system pathways.",
    "sourceDescription": "Educational reference description for PT-141 (Bremelanotide)."
  },
  "peptideContentPt141TypicalDose": "1.25–1.75 mg conforme necessário",
  "@peptideContentPt141TypicalDose": {
    "sourceString": "1.25–1.75 mg as needed",
    "sourceDescription": "Reference amount text for PT-141 (Bremelanotide); this is not a dosing recommendation."
  },
  "peptideContentPt141HalfLife": "~2 horas",
  "@peptideContentPt141HalfLife": {
    "sourceString": "~2 hours",
    "sourceDescription": "Educational half-life reference for PT-141 (Bremelanotide)."
  },
  "peptideContentPt141Notes": "Medicamento sob prescrição em alguns mercados. Usado conforme a necessidade, e não em um cronograma fixo. Efeitos colaterais comuns incluem náusea e aumentos transitórios da pressão arterial.",
  "@peptideContentPt141Notes": {
    "sourceString": "Prescription medication in some markets. Taken as needed rather than on a fixed schedule. Common side effects include nausea and transient blood pressure increases.",
    "sourceDescription": "Neutral educational notes for PT-141 (Bremelanotide); preserve non-prescriptive framing."
  },
  "peptideContentDsipDescription": "O peptídeo indutor de sono delta (DSIP) é um nonapeptídeo isolado do cérebro de coelhos na década de 1970. Foi estudado quanto a possíveis papéis na regulação do sono, na modulação da dor e na resposta ao estresse, embora seus mecanismos ainda não estejam totalmente esclarecidos.",
  "@peptideContentDsipDescription": {
    "sourceString": "Delta Sleep-Inducing Peptide (DSIP) is a nonapeptide isolated from rabbit brain in the 1970s. It has been studied for possible roles in sleep regulation, pain modulation, and stress response, though mechanisms remain unclear.",
    "sourceDescription": "Educational reference description for DSIP."
  },
  "peptideContentDsipTypicalDose": "100–500 mcg antes de dormir",
  "@peptideContentDsipTypicalDose": {
    "sourceString": "100–500 mcg before bed",
    "sourceDescription": "Reference amount text for DSIP; this is not a dosing recommendation."
  },
  "peptideContentDsipHalfLife": "~7 minutos",
  "@peptideContentDsipHalfLife": {
    "sourceString": "~7 minutes",
    "sourceDescription": "Educational half-life reference for DSIP."
  },
  "peptideContentDsipNotes": "Geralmente administrado antes de dormir. Meia-vida plasmática curta, mas os efeitos relatados podem durar mais do que ela. A base de evidências ainda é limitada.",
  "@peptideContentDsipNotes": {
    "sourceString": "Typically administered before bed. Short plasma half-life but reported effects may outlast it. Evidence base remains limited.",
    "sourceDescription": "Neutral educational notes for DSIP; preserve non-prescriptive framing."
  },
  "peptideContentThymosinAlpha1Description": "A timosina alfa-1 é um peptídeo de 28 aminoácidos originalmente isolado do tecido do timo. Foi aprovada em diversos países como terapia adjuvante moduladora do sistema imunológico (nome comercial Zadaxin) para hepatite B e C.",
  "@peptideContentThymosinAlpha1Description": {
    "sourceString": "Thymosin Alpha-1 is a 28-amino-acid peptide originally isolated from thymus tissue. It has been approved in multiple countries as an adjunct immune-modulating therapy (brand name Zadaxin) for hepatitis B and C.",
    "sourceDescription": "Educational reference description for Thymosin Alpha-1."
  },
  "peptideContentThymosinAlpha1TypicalDose": "1.6 mg duas vezes por semana",
  "@peptideContentThymosinAlpha1TypicalDose": {
    "sourceString": "1.6 mg twice weekly",
    "sourceDescription": "Reference amount text for Thymosin Alpha-1; this is not a dosing recommendation."
  },
  "peptideContentThymosinAlpha1HalfLife": "~2 horas",
  "@peptideContentThymosinAlpha1HalfLife": {
    "sourceString": "~2 hours",
    "sourceDescription": "Educational half-life reference for Thymosin Alpha-1."
  },
  "peptideContentThymosinAlpha1Notes": "Usado em vários mercados internacionais como parte de protocolos de modulação imunológica. Geralmente administrado duas vezes por semana. A pesquisa continua em diversas indicações.",
  "@peptideContentThymosinAlpha1Notes": {
    "sourceString": "Used in several international markets as part of immune-modulation protocols. Typically administered twice weekly. Research continues in various indications.",
    "sourceDescription": "Neutral educational notes for Thymosin Alpha-1; preserve non-prescriptive framing."
  },
  "peptideContentNadPlusDescription": "NAD+ (dinucleotídeo de nicotinamida e adenina) é uma coenzima central para o metabolismo energético celular e o reparo do DNA. O NAD+ injetável e seus precursores (NR, NMN) são estudados no contexto da saúde mitocondrial e do envelhecimento.",
  "@peptideContentNadPlusDescription": {
    "sourceString": "NAD+ (nicotinamide adenine dinucleotide) is a coenzyme central to cellular energy metabolism and DNA repair. Injectable NAD+ and its precursors (NR, NMN) are studied in the context of mitochondrial health and ageing.",
    "sourceDescription": "Educational reference description for NAD+."
  },
  "peptideContentNadPlusTypicalDose": "100–500 mg IV ou subcutâneo por sessão",
  "@peptideContentNadPlusTypicalDose": {
    "sourceString": "100–500 mg IV or SubQ per session",
    "sourceDescription": "Reference amount text for NAD+; this is not a dosing recommendation."
  },
  "peptideContentNadPlusHalfLife": "~90 minutos",
  "@peptideContentNadPlusHalfLife": {
    "sourceString": "~90 minutes",
    "sourceDescription": "Educational half-life reference for NAD+."
  },
  "peptideContentNadPlusNotes": "Tecnicamente uma coenzima, e não um peptídeo, mas frequentemente agrupado em protocolos de longevidade. Recomenda-se infusão lenta para minimizar rubor e desconforto.",
  "@peptideContentNadPlusNotes": {
    "sourceString": "Technically a coenzyme rather than a peptide, but commonly grouped with longevity protocols. Slow infusion is recommended to minimise flushing and discomfort.",
    "sourceDescription": "Neutral educational notes for NAD+; preserve non-prescriptive framing."
  },
  "peptideContentSermorelinDescription": "A sermorelina é um análogo sintético do hormônio liberador do hormônio do crescimento (GHRH). Tem sido usada clinicamente como agente diagnóstico da reserva de hormônio do crescimento e é comumente mencionada em contextos de bem-estar como peptídeo de suporte ao eixo do GH.",
  "@peptideContentSermorelinDescription": {
    "sourceString": "Sermorelin is a synthetic analogue of growth hormone-releasing hormone (GHRH). It has been used clinically as a diagnostic agent for growth-hormone reserve and is commonly discussed in wellness settings as a GH-axis support peptide.",
    "sourceDescription": "Educational reference description for Sermorelin."
  },
  "peptideContentSermorelinTypicalDose": "100–300 mcg antes de dormir",
  "@peptideContentSermorelinTypicalDose": {
    "sourceString": "100–300 mcg before bed",
    "sourceDescription": "Reference amount text for Sermorelin; this is not a dosing recommendation."
  },
  "peptideContentSermorelinHalfLife": "~10–20 minutos",
  "@peptideContentSermorelinHalfLife": {
    "sourceString": "~10–20 minutes",
    "sourceDescription": "Educational half-life reference for Sermorelin."
  },
  "peptideContentSermorelinNotes": "Frequentemente comparado ao CJC-1295 sem DAC, pois ambos atuam na via do GHRH. A meia-vida curta faz com que a dose noturna seja comum em protocolos não clínicos.",
  "@peptideContentSermorelinNotes": {
    "sourceString": "Often compared with CJC-1295 no-DAC because both act on the GHRH pathway. Short half-life makes evening dosing common in non-clinical protocols.",
    "sourceDescription": "Neutral educational notes for Sermorelin; preserve non-prescriptive framing."
  },
  "peptideContentAod9604Description": "AOD-9604 é um fragmento modificado do hormônio do crescimento humano, derivado da região 176–191. Foi investigado quanto à sinalização metabólica e lipolítica, mas as evidências publicadas em humanos são limitadas e inconsistentes.",
  "@peptideContentAod9604Description": {
    "sourceString": "AOD-9604 is a modified fragment of human growth hormone, derived from the 176–191 region. It has been investigated for metabolic and lipolysis signalling, but published human evidence is limited and mixed.",
    "sourceDescription": "Educational reference description for AOD-9604."
  },
  "peptideContentAod9604TypicalDose": "250–500 mcg por dia",
  "@peptideContentAod9604TypicalDose": {
    "sourceString": "250–500 mcg daily",
    "sourceDescription": "Reference amount text for AOD-9604; this is not a dosing recommendation."
  },
  "peptideContentAod9604HalfLife": "~30 minutos",
  "@peptideContentAod9604HalfLife": {
    "sourceString": "~30 minutes",
    "sourceDescription": "Educational half-life reference for AOD-9604."
  },
  "peptideContentAod9604Notes": "Também chamado de fragmento de HGH 176–191 em algumas discussões. Não é um medicamento aprovado para perda de peso; use linguagem neutra de acompanhamento e evite garantias de resultado.",
  "@peptideContentAod9604Notes": {
    "sourceString": "Also called HGH fragment 176–191 in some discussions. Not an approved weight-loss drug; use neutral tracking language and avoid outcome guarantees.",
    "sourceDescription": "Neutral educational notes for AOD-9604; preserve non-prescriptive framing."
  },
  "peptideContentKpvDescription": "KPV é uma sequência curta de tripeptídeo (lisina-prolina-valina) derivada do hormônio estimulante de alfa-melanócitos. É discutido em contextos de pesquisa relacionados à sinalização imunológica e da barreira intestinal.",
  "@peptideContentKpvDescription": {
    "sourceString": "KPV is a short tripeptide sequence (lysine-proline-valine) derived from alpha-melanocyte-stimulating hormone. It is discussed in research contexts for immune and gut-barrier signalling.",
    "sourceDescription": "Educational reference description for KPV."
  },
  "peptideContentKpvTypicalDose": "250–500 mcg por dia",
  "@peptideContentKpvTypicalDose": {
    "sourceString": "250–500 mcg daily",
    "sourceDescription": "Reference amount text for KPV; this is not a dosing recommendation."
  },
  "peptideContentKpvHalfLife": "Não bem estabelecida",
  "@peptideContentKpvHalfLife": {
    "sourceString": "Not well established",
    "sourceDescription": "Educational half-life reference for KPV."
  },
  "peptideContentKpvNotes": "Aparece em discussões sobre saúde intestinal e uso tópico, incluindo combinações informais com BPC-157. A evidência de dosagem em humanos é limitada, então os protocolos devem ser conservadores.",
  "@peptideContentKpvNotes": {
    "sourceString": "Appears in gut-health and topical discussions, including informal stacks with BPC-157. Human dosing evidence is limited, so protocols should be conservative.",
    "sourceDescription": "Neutral educational notes for KPV; preserve non-prescriptive framing."
  },
  "peptideContentSs31Description": "SS-31, também conhecido como elamipretida, é um tetrapeptídeo direcionado às mitocôndrias, estudado quanto às suas interações com a cardiolipina e a função da membrana mitocondrial. A pesquisa clínica tem se concentrado em condições mitocondriais e cardíacas raras.",
  "@peptideContentSs31Description": {
    "sourceString": "SS-31, also known as Elamipretide, is a mitochondria-targeted tetrapeptide studied for interactions with cardiolipin and mitochondrial membrane function. Clinical research has focused on rare mitochondrial and cardiac conditions.",
    "sourceDescription": "Educational reference description for SS-31 (Elamipretide)."
  },
  "peptideContentSs31TypicalDose": "Os protocolos de estudo variam",
  "@peptideContentSs31TypicalDose": {
    "sourceString": "Trial protocols vary",
    "sourceDescription": "Reference amount text for SS-31 (Elamipretide); this is not a dosing recommendation."
  },
  "peptideContentSs31HalfLife": "~4 horas",
  "@peptideContentSs31HalfLife": {
    "sourceString": "~4 hours",
    "sourceDescription": "Educational half-life reference for SS-31 (Elamipretide)."
  },
  "peptideContentSs31Notes": "Em fase de investigação em muitos contextos. Os protocolos usados pela comunidade costumam diferir das formulações de ensaios clínicos e devem ser tratados apenas como pesquisa.",
  "@peptideContentSs31Notes": {
    "sourceString": "Investigational in many contexts. Community protocols often differ from clinical-trial formulations and should be treated as research-only.",
    "sourceDescription": "Neutral educational notes for SS-31 (Elamipretide); preserve non-prescriptive framing."
  },
  "peptideContentLl37Description": "LL-37 é um peptídeo antimicrobiano catelicidina humano envolvido na sinalização imunológica inata. É discutido em comunidades de pesquisa quanto a vias de defesa do hospedeiro e resposta tecidual, mas as considerações de segurança são significativas.",
  "@peptideContentLl37Description": {
    "sourceString": "LL-37 is a human cathelicidin antimicrobial peptide involved in innate immune signalling. It is discussed in research communities for host-defense and tissue-response pathways, but safety considerations are significant.",
    "sourceDescription": "Educational reference description for LL-37."
  },
  "peptideContentLl37TypicalDose": "Os protocolos de pesquisa variam",
  "@peptideContentLl37TypicalDose": {
    "sourceString": "Research protocols vary",
    "sourceDescription": "Reference amount text for LL-37; this is not a dosing recommendation."
  },
  "peptideContentLl37HalfLife": "Não bem estabelecida",
  "@peptideContentLl37HalfLife": {
    "sourceString": "Not well established",
    "sourceDescription": "Educational half-life reference for LL-37."
  },
  "peptideContentLl37Notes": "Altamente experimental fora de pesquisas controladas. Como peptídeos antimicrobianos podem afetar a sinalização imunológica, é importante manter uma abordagem educativa conservadora.",
  "@peptideContentLl37Notes": {
    "sourceString": "Highly experimental outside controlled research. Because antimicrobial peptides can affect immune signalling, conservative educational framing is important.",
    "sourceDescription": "Neutral educational notes for LL-37; preserve non-prescriptive framing."
  },
  "peptideContentDihexaDescription": "Dihexa é um análogo peptídico derivado da angiotensina IV, ativo por via oral, estudado pré-clinicamente quanto à sinalização do fator de crescimento de hepatócitos/c-Met e à atividade sinaptogênica. Os dados de segurança e eficácia em humanos não estão estabelecidos.",
  "@peptideContentDihexaDescription": {
    "sourceString": "Dihexa is an orally active angiotensin IV-derived peptide analogue studied preclinically for hepatocyte growth factor/c-Met signalling and synaptogenic activity. Human safety and efficacy data are not established.",
    "sourceDescription": "Educational reference description for Dihexa."
  },
  "peptideContentDihexaTypicalDose": "Apenas para pesquisa; os protocolos variam",
  "@peptideContentDihexaTypicalDose": {
    "sourceString": "Research-only; protocols vary",
    "sourceDescription": "Reference amount text for Dihexa; this is not a dosing recommendation."
  },
  "peptideContentDihexaHalfLife": "Não bem estabelecida",
  "@peptideContentDihexaHalfLife": {
    "sourceString": "Not well established",
    "sourceDescription": "Educational half-life reference for Dihexa."
  },
  "peptideContentDihexaNotes": "Popular em discussões sobre nootrópicos, mas ainda muito experimental. Trate como um registro de composto de pesquisa, e não como um protocolo sugerido.",
  "@peptideContentDihexaNotes": {
    "sourceString": "Popular in nootropic discussions but very experimental. Treat as a research compound entry rather than a suggested protocol.",
    "sourceDescription": "Neutral educational notes for Dihexa; preserve non-prescriptive framing."
  },
  "peptideContentGhrp2Description": "GHRP-2 é um peptídeo sintético liberador do hormônio do crescimento que atua como agonista do receptor de grelina. Foi estudado quanto à secreção de GH, à sinalização de apetite e a testes endócrinos.",
  "@peptideContentGhrp2Description": {
    "sourceString": "GHRP-2 is a synthetic growth hormone-releasing peptide that acts as a ghrelin receptor agonist. It has been studied for GH secretion, appetite signalling, and endocrine testing.",
    "sourceDescription": "Educational reference description for GHRP-2."
  },
  "peptideContentGhrp2TypicalDose": "100–300 mcg por injeção",
  "@peptideContentGhrp2TypicalDose": {
    "sourceString": "100–300 mcg per injection",
    "sourceDescription": "Reference amount text for GHRP-2; this is not a dosing recommendation."
  },
  "peptideContentGhrp2HalfLife": "~20–30 minutos",
  "@peptideContentGhrp2HalfLife": {
    "sourceString": "~20–30 minutes",
    "sourceDescription": "Educational half-life reference for GHRP-2."
  },
  "peptideContentGhrp2Notes": "Frequentemente combinado com um análogo de GHRH, como CJC-1295 sem DAC ou Sermorelin. Pode afetar apetite, cortisol e prolactina mais do que o Ipamorelin.",
  "@peptideContentGhrp2Notes": {
    "sourceString": "Often paired with a GHRH analogue such as CJC-1295 no-DAC or Sermorelin. It may affect appetite, cortisol, and prolactin more than Ipamorelin.",
    "sourceDescription": "Neutral educational notes for GHRP-2; preserve non-prescriptive framing."
  },
  "peptideContentGhrp6Description": "GHRP-6 é um hexapeptídeo sintético e agonista do receptor de grelina estudado quanto à liberação do hormônio do crescimento e à sinalização de apetite. É um dos peptídeos mais antigos da família GHRP.",
  "@peptideContentGhrp6Description": {
    "sourceString": "GHRP-6 is a synthetic hexapeptide and ghrelin receptor agonist studied for growth-hormone release and appetite signalling. It is one of the older peptides in the GHRP family.",
    "sourceDescription": "Educational reference description for GHRP-6."
  },
  "peptideContentGhrp6TypicalDose": "100–300 mcg por injeção",
  "@peptideContentGhrp6TypicalDose": {
    "sourceString": "100–300 mcg per injection",
    "sourceDescription": "Reference amount text for GHRP-6; this is not a dosing recommendation."
  },
  "peptideContentGhrp6HalfLife": "~20–30 minutos",
  "@peptideContentGhrp6HalfLife": {
    "sourceString": "~20–30 minutes",
    "sourceDescription": "Educational half-life reference for GHRP-6."
  },
  "peptideContentGhrp6Notes": "O uso pela comunidade costuma enfatizar a estimulação do apetite. Opções mais seletivas, como o Ipamorelin, costumam ser preferidas quando os efeitos sobre o apetite não são desejados.",
  "@peptideContentGhrp6Notes": {
    "sourceString": "Community use often emphasises appetite stimulation. More selective options such as Ipamorelin are commonly preferred when appetite effects are unwanted.",
    "sourceDescription": "Neutral educational notes for GHRP-6; preserve non-prescriptive framing."
  },
  "peptideContentHexarelinDescription": "A hexarelina é um secretagogo sintético do hormônio do crescimento e agonista do receptor de grelina estudado quanto à liberação de GH e a sinais de pesquisa cardiovascular. Geralmente é considerada um dos GHRPs mais potentes.",
  "@peptideContentHexarelinDescription": {
    "sourceString": "Hexarelin is a synthetic growth hormone secretagogue and ghrelin receptor agonist studied for GH release and cardiovascular research signals. It is generally considered one of the more potent GHRPs.",
    "sourceDescription": "Educational reference description for Hexarelin."
  },
  "peptideContentHexarelinTypicalDose": "100–200 mcg por injeção",
  "@peptideContentHexarelinTypicalDose": {
    "sourceString": "100–200 mcg per injection",
    "sourceDescription": "Reference amount text for Hexarelin; this is not a dosing recommendation."
  },
  "peptideContentHexarelinHalfLife": "~70 minutos",
  "@peptideContentHexarelinHalfLife": {
    "sourceString": "~70 minutes",
    "sourceDescription": "Educational half-life reference for Hexarelin."
  },
  "peptideContentHexarelinNotes": "Frequentemente usado em ciclos mais conservadores do que o Ipamorelin devido à potência e a preocupações com dessensibilização discutidas em comunidades de pesquisa.",
  "@peptideContentHexarelinNotes": {
    "sourceString": "Often cycled more conservatively than Ipamorelin due to potency and desensitisation concerns discussed in research communities.",
    "sourceDescription": "Neutral educational notes for Hexarelin; preserve non-prescriptive framing."
  },
  "peptideContentIgf1Lr3Description": "IGF-1 LR3 é um análogo modificado do fator de crescimento semelhante à insulina tipo 1, com substituições de aminoácidos que reduzem a afinidade por proteínas de ligação e prolongam a atividade. É discutido principalmente em contextos avançados de pesquisa sobre desempenho e crescimento celular.",
  "@peptideContentIgf1Lr3Description": {
    "sourceString": "IGF-1 LR3 is a modified insulin-like growth factor-1 analogue with amino-acid substitutions that reduce binding-protein affinity and extend activity. It is discussed mostly in advanced performance and cell-growth research contexts.",
    "sourceDescription": "Educational reference description for IGF-1 LR3."
  },
  "peptideContentIgf1Lr3TypicalDose": "20–50 mcg por dia em protocolos de pesquisa",
  "@peptideContentIgf1Lr3TypicalDose": {
    "sourceString": "20–50 mcg daily in research protocols",
    "sourceDescription": "Reference amount text for IGF-1 LR3; this is not a dosing recommendation."
  },
  "peptideContentIgf1Lr3HalfLife": "~20–30 horas",
  "@peptideContentIgf1Lr3HalfLife": {
    "sourceString": "~20–30 hours",
    "sourceDescription": "Educational half-life reference for IGF-1 LR3."
  },
  "peptideContentIgf1Lr3Notes": "Composto de pesquisa de maior risco. Possíveis preocupações com sinalização de glicose e crescimento tecidual tornam a supervisão médica especialmente importante.",
  "@peptideContentIgf1Lr3Notes": {
    "sourceString": "Higher-risk research compound. Potential glucose and tissue-growth signalling concerns make medical supervision especially important.",
    "sourceDescription": "Neutral educational notes for IGF-1 LR3; preserve non-prescriptive framing."
  },
  "peptideContentIgf1DesDescription": "IGF-1 DES é um análogo mais curto do IGF-1, ao qual faltam os três primeiros aminoácidos. É discutido como uma variante de IGF de ação mais curta em pesquisas de sinalização tecidual local.",
  "@peptideContentIgf1DesDescription": {
    "sourceString": "IGF-1 DES is a shorter IGF-1 analogue missing the first three amino acids. It is discussed as a shorter-acting IGF variant in local tissue-signalling research.",
    "sourceDescription": "Educational reference description for IGF-1 DES."
  },
  "peptideContentIgf1DesTypicalDose": "20–50 mcg em protocolos de pesquisa",
  "@peptideContentIgf1DesTypicalDose": {
    "sourceString": "20–50 mcg in research protocols",
    "sourceDescription": "Reference amount text for IGF-1 DES; this is not a dosing recommendation."
  },
  "peptideContentIgf1DesHalfLife": "~20–30 minutos",
  "@peptideContentIgf1DesHalfLife": {
    "sourceString": "~20–30 minutes",
    "sourceDescription": "Educational half-life reference for IGF-1 DES."
  },
  "peptideContentIgf1DesNotes": "Muito avançado e experimental. Evite sugestões amplas de protocolo, pois os dados de segurança em humanos e o monitoramento adequado ainda são limitados.",
  "@peptideContentIgf1DesNotes": {
    "sourceString": "Very advanced and experimental. Avoid broad protocol suggestions because human safety data and appropriate monitoring are limited.",
    "sourceDescription": "Neutral educational notes for IGF-1 DES; preserve non-prescriptive framing."
  },
  "peptideContentPegMgfDescription": "PEG-MGF é uma variante peguilada do fator de crescimento mecânico, um peptídeo de splice variante do IGF-1. A peguilação tem o objetivo de prolongar o tempo de circulação em comparação com o MGF não modificado.",
  "@peptideContentPegMgfDescription": {
    "sourceString": "PEG-MGF is a pegylated variant of mechano growth factor, an IGF-1 splice-variant peptide. The pegylation is intended to extend circulation time compared with unmodified MGF.",
    "sourceDescription": "Educational reference description for PEG-MGF."
  },
  "peptideContentPegMgfTypicalDose": "100–300 mcg semanais em protocolos de pesquisa",
  "@peptideContentPegMgfTypicalDose": {
    "sourceString": "100–300 mcg weekly in research protocols",
    "sourceDescription": "Reference amount text for PEG-MGF; this is not a dosing recommendation."
  },
  "peptideContentPegMgfHalfLife": "Prolongada pela peguilação",
  "@peptideContentPegMgfHalfLife": {
    "sourceString": "Extended by PEGylation",
    "sourceDescription": "Educational half-life reference for PEG-MGF."
  },
  "peptideContentPegMgfNotes": "Comum em fóruns de desempenho, mas não é uma terapia aprovada. Trate como um registro de pesquisa avançado, com padrões de acompanhamento conservadores.",
  "@peptideContentPegMgfNotes": {
    "sourceString": "Common in performance forums but not an approved therapy. Treat as an advanced research entry with conservative tracking defaults.",
    "sourceDescription": "Neutral educational notes for PEG-MGF; preserve non-prescriptive framing."
  },
  "peptideContentMk677Description": "MK-677, também conhecido como ibutamoren, é um agonista do receptor de grelina e secretagogo do hormônio do crescimento ativo por via oral. Não é um peptídeo, mas é comumente discutido ao lado de peptídeos do eixo do GH.",
  "@peptideContentMk677Description": {
    "sourceString": "MK-677, also known as Ibutamoren, is an orally active ghrelin receptor agonist and growth-hormone secretagogue. It is not a peptide, but it is commonly discussed alongside GH-axis peptides.",
    "sourceDescription": "Educational reference description for MK-677 (Ibutamoren)."
  },
  "peptideContentMk677TypicalDose": "10–25 mg por dia",
  "@peptideContentMk677TypicalDose": {
    "sourceString": "10–25 mg daily",
    "sourceDescription": "Reference amount text for MK-677 (Ibutamoren); this is not a dosing recommendation."
  },
  "peptideContentMk677HalfLife": "~24 horas",
  "@peptideContentMk677HalfLife": {
    "sourceString": "~24 hours",
    "sourceDescription": "Educational half-life reference for MK-677 (Ibutamoren)."
  },
  "peptideContentMk677Notes": "Composto relacionado, não um peptídeo. As discussões da comunidade costumam mencionar apetite, retenção de líquidos, sono e monitoramento de glicose.",
  "@peptideContentMk677Notes": {
    "sourceString": "Related compound, not a peptide. Community discussions often mention appetite, water retention, sleep, and glucose-monitoring considerations.",
    "sourceDescription": "Neutral educational notes for MK-677 (Ibutamoren); preserve non-prescriptive framing."
  },
  "peptideContentFiveAmino1mqDescription": "5-Amino-1MQ é um inibidor de molécula pequena da NNMT, discutido em comunidades voltadas ao metabolismo e à composição corporal. Não é um peptídeo, mas costuma aparecer em combinações de longevidade e perda de gordura próximas a peptídeos.",
  "@peptideContentFiveAmino1mqDescription": {
    "sourceString": "5-Amino-1MQ is a small-molecule NNMT inhibitor discussed in metabolic and body-composition communities. It is not a peptide, but it often appears in peptide-adjacent longevity and fat-loss stacks.",
    "sourceDescription": "Educational reference description for 5-Amino-1MQ."
  },
  "peptideContentFiveAmino1mqTypicalDose": "25–100 mg por dia",
  "@peptideContentFiveAmino1mqTypicalDose": {
    "sourceString": "25–100 mg daily",
    "sourceDescription": "Reference amount text for 5-Amino-1MQ; this is not a dosing recommendation."
  },
  "peptideContentFiveAmino1mqHalfLife": "Não bem estabelecida",
  "@peptideContentFiveAmino1mqHalfLife": {
    "sourceString": "Not well established",
    "sourceDescription": "Educational half-life reference for 5-Amino-1MQ."
  },
  "peptideContentFiveAmino1mqNotes": "Composto relacionado, não um peptídeo. A evidência em humanos é limitada; evite alegações sobre perda de gordura ou sensibilidade à insulina.",
  "@peptideContentFiveAmino1mqNotes": {
    "sourceString": "Related compound, not a peptide. Human evidence is limited; avoid claims about fat loss or insulin sensitivity outcomes.",
    "sourceDescription": "Neutral educational notes for 5-Amino-1MQ; preserve non-prescriptive framing."
  },
  "peptideContentTesofensineDescription": "A tesofensina é um inibidor oral da recaptação de monoaminas investigado para obesidade e condições neurodegenerativas. Não é um peptídeo, mas é frequentemente discutida em comunidades de controle de peso próximas a compostos GLP-1.",
  "@peptideContentTesofensineDescription": {
    "sourceString": "Tesofensine is an oral monoamine reuptake inhibitor investigated for obesity and neurodegenerative conditions. It is not a peptide, but it is frequently discussed in weight-management communities near GLP-1 compounds.",
    "sourceDescription": "Educational reference description for Tesofensine."
  },
  "peptideContentTesofensineTypicalDose": "0.25–0.5 mg por dia em estudos",
  "@peptideContentTesofensineTypicalDose": {
    "sourceString": "0.25–0.5 mg daily in studies",
    "sourceDescription": "Reference amount text for Tesofensine; this is not a dosing recommendation."
  },
  "peptideContentTesofensineHalfLife": "~9 dias",
  "@peptideContentTesofensineHalfLife": {
    "sourceString": "~9 days",
    "sourceDescription": "Educational half-life reference for Tesofensine."
  },
  "peptideContentTesofensineNotes": "Composto relacionado, não um peptídeo. Como afeta vias de neurotransmissores, pressão arterial e frequência cardíaca, a triagem de interações é importante.",
  "@peptideContentTesofensineNotes": {
    "sourceString": "Related compound, not a peptide. Because it affects neurotransmitter pathways, blood pressure, heart rate, and interaction screening matter.",
    "sourceDescription": "Neutral educational notes for Tesofensine; preserve non-prescriptive framing."
  },
  "peptideContentRu58841Description": "RU-58841 é um antiandrógeno tópico não esteroidal pesquisado quanto à sinalização do receptor de andrógeno em contextos de folículos capilares. Não é um peptídeo, mas costuma ser discutido em comunidades estéticas próximas a peptídeos.",
  "@peptideContentRu58841Description": {
    "sourceString": "RU-58841 is a topical nonsteroidal antiandrogen researched for androgen-receptor signalling in hair-follicle contexts. It is not a peptide, but it is often discussed in peptide-adjacent aesthetic communities.",
    "sourceDescription": "Educational reference description for RU-58841."
  },
  "peptideContentRu58841TypicalDose": "Tópico, 25–50 mg por dia em protocolos informais",
  "@peptideContentRu58841TypicalDose": {
    "sourceString": "Topical 25–50 mg daily in informal protocols",
    "sourceDescription": "Reference amount text for RU-58841; this is not a dosing recommendation."
  },
  "peptideContentRu58841HalfLife": "Não bem estabelecida",
  "@peptideContentRu58841HalfLife": {
    "sourceString": "Not well established",
    "sourceDescription": "Educational half-life reference for RU-58841."
  },
  "peptideContentRu58841Notes": "Composto relacionado, não um peptídeo e não um medicamento aprovado. Preocupações com controle de qualidade e exposição sistêmica são pontos comuns de discussão.",
  "@peptideContentRu58841Notes": {
    "sourceString": "Related compound, not a peptide and not an approved medication. Quality-control and systemic exposure concerns are common discussion points.",
    "sourceDescription": "Neutral educational notes for RU-58841; preserve non-prescriptive framing."
  },
  "peptideContentEducationalDisclaimer": "Apenas para referência educativa. Não é orientação médica. Os peptídeos de pesquisa não são aprovados para uso humano na maioria das jurisdições — sempre consulte um profissional de saúde qualificado.",
  "@peptideContentEducationalDisclaimer": {
    "sourceString": "For educational reference only. Not medical advice. Research peptides are not approved for human use in most jurisdictions — always consult a qualified healthcare provider.",
    "sourceDescription": "Safety disclaimer shown below every bundled peptide reference. Preserve educational-only, non-medical-advice wording."
  },
