    "sourceString": "1.25–1.75 mg as needed",
    "sourceDescription": "Reference amount text for PT-141 (Bremelanotide); this is not a dosing recommendation."
  },
  "peptideContentPt141HalfLife": "~2시간",
  "@peptideContentPt141HalfLife": {
    "description": "Educational half-life reference for PT-141 (Bremelanotide).",
