  "peptideContentHcgDescription": "A gonadotrofina coriónica humana (HCG) é uma hormona glicoproteica utilizada em contextos clínicos regulados e frequentemente mencionada a par de protocolos de peptídeos. Esta entrada é fornecida como uma referência neutra de registo para os horários introduzidos pelo utilizador.",
  "@peptideContentHcgDescription": {
    "description": "Educational reference description for HCG.",
    "sourceString": "Human chorionic gonadotropin (HCG) is a glycoprotein hormone used in regulated clinical settings and frequently discussed alongside peptide protocols. This entry is provided as a neutral tracking reference for user-entered schedules.",
    "sourceDescription": "Educational reference description for HCG."
  },
  "peptideContentHcgTypicalDose": "UI inseridas pelo utilizador",
  "@peptideContentHcgTypicalDose": {
    "description": "Reference amount text for HCG; this is not a dosing recommendation.",
    "sourceString": "User-entered IU",
    "sourceDescription": "Reference amount text for HCG; this is not a dosing recommendation."
  },
  "peptideContentHcgHalfLife": "~24-36 horas",
  "@peptideContentHcgHalfLife": {
    "description": "Educational half-life reference for HCG.",
    "sourceString": "~24-36 hours",
    "sourceDescription": "Educational half-life reference for HCG."
  },
  "peptideContentHcgNotes": "Sujeito a receita médica em muitas jurisdições. Registe apenas o que já foi indicado por um profissional de saúde qualificado; o PepMod não fornece orientações de dosagem para HCG.",
  "@peptideContentHcgNotes": {
    "description": "Neutral educational notes for HCG; preserve non-prescriptive framing.",
    "sourceString": "Prescription-only in many jurisdictions. Track only what has already been directed by a qualified healthcare professional; PepMod does not provide HCG dosing guidance.",
    "sourceDescription": "Neutral educational notes for HCG; preserve non-prescriptive framing."
  },
  "peptideContentBpc157Description": "O BPC-157 (Body Protection Compound 157) é um peptídeo sintético de 15 aminoácidos derivado de uma proteína encontrada no suco gástrico. Tem sido estudado em modelos animais quanto ao seu papel na reparação de tecidos moles e do revestimento intestinal. Os dados clínicos em humanos continuam limitados.",
  "@peptideContentBpc157Description": {
    "description": "Educational reference description for BPC-157.",
    "sourceString": "BPC-157 (Body Protection Compound 157) is a 15-amino-acid synthetic peptide derived from a protein found in gastric juice. It has been studied in animal models for its role in soft-tissue and gut-lining repair. Human clinical data remains limited.",
    "sourceDescription": "Educational reference description for BPC-157."
  },
  "peptideContentBpc157TypicalDose": "250–500 mcg",
  "@peptideContentBpc157TypicalDose": {
